# Use the connection string from the hackathon Atlas Sandbox project.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fleetlearn
PORT=3000

# Optional model proposer. Without one, FleetLearn still evolves via local search.
# Model suggestions are schema-validated and scored by the simulator like any other candidate.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Alternative: any OpenAI-compatible chat endpoint (used only when ANTHROPIC_API_KEY is empty).
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=

